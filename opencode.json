{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/qwen3.7-plus",
  "agents": {
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "write",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "build": {
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "write",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  },
  "instructions": [
    "plugins/assist-plugin/rules/writing-standard-compact.md"
  ],
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 120000
    },
    "buffer": "10%"
  },
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "write",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
